@page "/railcar-trips"
@inject RailcarTripsApiClient ApiClient

<PageTitle>Railcar Trips</PageTitle>

<h1 class="mb-4">Railcar Trips</h1>

<div class="card section-card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Import Equipment Events</h5>

        <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center">
            <label class="@FilePickerButtonCss" title="Upload CSV">
                <i class="bi bi-upload"></i>
                <InputFile OnChange="OnFileSelected"
                           accept=".csv"
                           disabled="@_isUploading"
                           class="d-none" />
            </label>
            <span class="small text-muted">@( _selectedFile?.Name ?? "No file selected" )</span>
            <button class="btn btn-primary" @onclick="UploadAndProcessAsync" disabled="@(!_canUpload)">
                @if (_isUploading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <span>Upload & Process</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_uploadError))
        {
            <div class="mt-3">
                <AlertBox Message="@_uploadError" Severity="danger" />
            </div>
        }
    </div>
</div>

@if (_lastImportResult is not null)
{
    <div class="stats-grid mb-4">
        <StatCard Label="Imported" Value="@_lastImportResult.Imported" />
        <StatCard Label="Duplicates" Value="@_lastImportResult.Duplicates" />
        <StatCard Label="Trips Created" Value="@_lastImportResult.TripsCreated" />
        <StatCard Label="Trips Closed" Value="@_lastImportResult.TripsClosed" />
        <StatCard Label="Ignored Events" Value="@_lastImportResult.IgnoredEventsCount" />
        <StatCard Label="Anomalies" Value="@_lastImportResult.AnomaliesCount" />
    </div>
}

<div class="card section-card">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">
                Trips
                @if (_isLoadingTrips)
                {
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                }
            </h5>
            <span class="text-muted">Total: @_tripsPage.TotalCount</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_tripsError))
        {
            <AlertBox Message="@_tripsError" Severity="danger" />
        }
        else
        {
            <div class="table-responsive trips-table-wrap">
                <table class="table table-sm align-middle trips-table">
                    <thead>
                        <tr>
                            <th>Equipment Id</th>
                            <th>Origin</th>
                            <th>Destination</th>
                            <th>Start (UTC)</th>
                            <th>End (UTC)</th>
                            <th>Hours</th>
                        </tr>
                        <tr class="filters-row">
                            <th>
                                <input class="form-control form-control-sm"
                                       @bind="_equipmentIdFilterDraft"
                                       @bind:event="oninput"
                                       @onkeydown="OnFilterKeyDown"
                                       placeholder="Filter id" />
                            </th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="ApplyFilterAsync"
                                            disabled="@_isLoadingTrips">
                                        Apply
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="ClearFilterAsync"
                                            disabled="@_isLoadingTrips">
                                        Clear
                                    </button>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingTrips)
                        {
                            <tr>
                                <td colspan="6" class="text-muted">Loading...</td>
                            </tr>
                        }
                        else if (_tripsPage.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-muted">No trips found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var trip in _tripsPage.Items)
                            {
                                <tr @key="trip.Id" class="@GetTripRowCss(trip.Id)" @onclick="() => SelectTripAsync(trip.Id)">
                                    <td>@trip.EquipmentId</td>
                                    <td>@trip.Origin</td>
                                    <td>@trip.Destination</td>
                                    <td>@FormatUtcDateTime(trip.StartUtc)</td>
                                    <td>@FormatTripEndUtc(trip.EndUtc)</td>
                                    <td>@FormatTripHours(trip.TotalTripHours, trip.EndUtc)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-outline-secondary"
                        @onclick="PreviousPageAsync"
                        disabled="@(_isLoadingTrips || _tripsPage.Page <= 1)">
                    Prev
                </button>
                <button class="btn btn-outline-secondary"
                        @onclick="NextPageAsync"
                        disabled="@(_isLoadingTrips || !HasNextPage)">
                    Next
                </button>
            </div>
        }
    </div>
</div>

<div class="card section-card mt-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Trip Events</h5>

        @if (_selectedTripId is null)
        {
            <p class="text-muted mb-3">Select a trip to see its events.</p>
        }
        else
        {
            <p class="selected-trip-label mb-3">Selected Trip: #@_selectedTripId - @_selectedTripEquipmentId</p>
        }

        @if (_selectedTripId is null)
        {
            <div class="empty-state">Select a trip to see its events.</div>
        }
        else if (_isLoadingEvents)
        {
            <p class="text-muted mb-0">Loading events...</p>
        }
        else if (!string.IsNullOrWhiteSpace(_eventsError))
        {
            <AlertBox Message="@_eventsError" Severity="danger" />
        }
        else if (_tripEvents.Count == 0)
        {
            <div class="empty-state">No events found for this trip.</div>
        }
        else
        {
            <div class="table-responsive events-table-wrap">
                <table class="table table-sm align-middle mb-0 events-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Equipment Id</th>
                            <th>City</th>
                            <th>Event Code</th>
                            <th>Event UTC (UTC)</th>
                            <th>Event Local (Local)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _tripEvents.OrderBy(e => e.EventUtcTime))
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.EquipmentId</td>
                                <td>@FormatCity(item.CityName, item.CityId)</td>
                                <td>@item.EventCode</td>
                                <td>@FormatUtcDateTime(item.EventUtcTime)</td>
                                <td>@FormatLocalDateTime(item.EventLocalTime)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 20;

    private IBrowserFile? _selectedFile;
    private bool _isUploading;
    private string? _uploadError;
    private ImportResultDto? _lastImportResult;

    private bool _isLoadingTrips = true;
    private string? _tripsError;
    private string _equipmentIdFilter = string.Empty;
    private string _equipmentIdFilterDraft = string.Empty;
    private PagedResult<TripGridRowDto> _tripsPage = new(1, PageSize, 0, Array.Empty<TripGridRowDto>());

    private long? _selectedTripId;
    private string? _selectedTripEquipmentId;
    private bool _isLoadingEvents;
    private string? _eventsError;
    private IReadOnlyList<EquipmentEventDto> _tripEvents = Array.Empty<EquipmentEventDto>();

    private bool _canUpload => _selectedFile is not null && !_isUploading;
    private bool HasNextPage => _tripsPage.Page * _tripsPage.PageSize < _tripsPage.TotalCount;
    private string FilePickerButtonCss =>
        _isUploading ? "btn btn-outline-secondary btn-sm mb-0 file-picker-btn disabled" : "btn btn-outline-secondary btn-sm mb-0 file-picker-btn";

    protected override async Task OnInitializedAsync()
    {
        _equipmentIdFilterDraft = _equipmentIdFilter;
        await LoadTripsAsync(1);
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _uploadError = null;
    }

    private async Task UploadAndProcessAsync()
    {
        if (_selectedFile is null)
        {
            _uploadError = "Select a CSV file first.";
            return;
        }

        _isUploading = true;
        _uploadError = null;

        try
        {
            _lastImportResult = await ApiClient.ImportEquipmentEventsAsync(_selectedFile, CancellationToken.None);
            await LoadTripsAsync(1);
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        _equipmentIdFilter = _equipmentIdFilterDraft.Trim();
        await LoadTripsAsync(1);
    }

    private async Task ClearFilterAsync()
    {
        _equipmentIdFilterDraft = string.Empty;
        _equipmentIdFilter = string.Empty;
        await LoadTripsAsync(1);
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilterAsync();
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_tripsPage.Page <= 1)
        {
            return;
        }

        await LoadTripsAsync(_tripsPage.Page - 1);
    }

    private async Task NextPageAsync()
    {
        if (!HasNextPage)
        {
            return;
        }

        await LoadTripsAsync(_tripsPage.Page + 1);
    }

    private async Task LoadTripsAsync(int page)
    {
        _isLoadingTrips = true;
        _tripsError = null;

        try
        {
            _tripsPage = await ApiClient.GetTripsAsync(page, PageSize, _equipmentIdFilter, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _tripsError = ex.Message;
            _tripsPage = new PagedResult<TripGridRowDto>(page, PageSize, 0, Array.Empty<TripGridRowDto>());
        }
        finally
        {
            if (_selectedTripId is not null)
            {
                var selectedTrip = _tripsPage.Items.FirstOrDefault(t => t.Id == _selectedTripId.Value);
                if (selectedTrip is null)
                {
                    _selectedTripId = null;
                    _selectedTripEquipmentId = null;
                    _tripEvents = Array.Empty<EquipmentEventDto>();
                }
                else
                {
                    _selectedTripEquipmentId = selectedTrip.EquipmentId;
                }
            }

            _isLoadingTrips = false;
        }
    }

    private async Task SelectTripAsync(long tripId)
    {
        _selectedTripId = tripId;
        _selectedTripEquipmentId = _tripsPage.Items.FirstOrDefault(t => t.Id == tripId)?.EquipmentId;
        StateHasChanged();
        _isLoadingEvents = true;
        _eventsError = null;
        _tripEvents = Array.Empty<EquipmentEventDto>();

        try
        {
            _tripEvents = await ApiClient.GetTripEventsAsync(tripId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _eventsError = ex.Message;
        }
        finally
        {
            _isLoadingEvents = false;
        }
    }

    private string GetTripRowCss(long tripId) => _selectedTripId == tripId ? "selected-row" : string.Empty;

    private static string FormatUtcDateTime(DateTime value) =>
        $"{value.ToUniversalTime():yyyy-MM-dd HH:mm} UTC";

    private static string FormatTripEndUtc(DateTime? value) =>
        value.HasValue ? FormatUtcDateTime(value.Value) : "-";

    private static string FormatLocalDateTime(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm") : "-";

    private static string FormatTripHours(decimal? value, DateTime? endUtc) =>
        endUtc.HasValue && value.HasValue
            ? value.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
            : "-";

    private static string FormatCity(string? cityName, int cityId) =>
        string.IsNullOrWhiteSpace(cityName) ? $"City #{cityId}" : cityName;
}
